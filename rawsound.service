[Unit]
Description=RAWSound website

Wants=network.target
After=syslog.target network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/rawsound
ExecStart=/var/www/rawsound/rawsound

# Allow binding to privileged ports (80, 443) without root
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadOnlyPaths=/etc/letsencrypt

# Allow read access to static files directory
ReadOnlyPaths=/var/www/rawsound/static

Restart=on-failure
RestartSec=10
KillMode=process

[Install]
WantedBy=multi-user.target
